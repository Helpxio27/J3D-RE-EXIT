def resolve_collision_x(player_rect, collider, vel_x):
    on_wall = False         #verifie les colli horizontales des murs
    wall_dir = 0

    if player_rect.colliderect(collider):
        if vel_x > 0:
            player_rect.right = collider.left
            wall_dir = 1
        elif vel_x < 0:
            player_rect.left = collider.right
            wall_dir = -1

        vel_x = 0
        on_wall = True

    return vel_x, on_wall, wall_dir


def resolve_collision_y(player_rect, collider, vel_y):
    on_ground = False             #verifie les colli verticales sol et plafond

    if player_rect.colliderect(collider):
        if vel_y > 0:
            player_rect.bottom = collider.top
            vel_y = 0
            on_ground = True
        elif vel_y < 0:
            player_rect.top = collider.bottom
            vel_y = 0

    return vel_y, on_ground
