import pygame
import sys
from settings import SCREEN_WIDTH, SCREEN_HEIGHT, FPS, BACKGROUND_COLOR
from player import Player


class Game:
    def __init__(self):
        pygame.init()

        self.screen = pygame.display.set_mode((SCREEN_WIDTH, SCREEN_HEIGHT))
        pygame.display.set_caption("yo test test")

        self.clock = pygame.time.Clock()
        self.running = True

        self.player = Player(100, SCREEN_HEIGHT - 90)

        self.colliders = [
            pygame.Rect(0, SCREEN_HEIGHT - 40, SCREEN_WIDTH, 40),     # sol
            pygame.Rect(0, 0, 40, SCREEN_HEIGHT),                     # mur gauche
            pygame.Rect(SCREEN_WIDTH - 40, 0, 40, SCREEN_HEIGHT),     # mur droit
            pygame.Rect(0, 0, SCREEN_WIDTH, 40),                      # plafond
            pygame.Rect(300, 350, 200, 30),                           # plateforme
            pygame.Rect(500, 200, 40, 200)                            # mur interne
        ]

    def run(self):
        while self.running:
            self.clock.tick(FPS)
            self.handle_events()
            self.update()
            self.draw()

        pygame.quit()
        sys.exit()

    def handle_events(self):
        for event in pygame.event.get():
            if event.type == pygame.QUIT:
                self.running = False

    def update(self):
        self.player.update(self.colliders)

    def draw(self):
        self.screen.fill(BACKGROUND_COLOR)

        for c in self.colliders:
            pygame.draw.rect(self.screen, (220, 220, 220), c)

        self.player.draw(self.screen)
        pygame.display.flip()
